{
  "name": "slipstream",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:mock": "node scripts/dev.ts mock",
    "dev:info": "node scripts/dev.ts info",
    "dev:reset": "node scripts/dev.ts reset",
    "doctor": "node scripts/doctor.ts",
    "build": "pnpm --filter @slipstream/web build",
    "start": "pnpm --filter @slipstream/server start",
    "test": "pnpm test:scripts && pnpm -r --workspace-concurrency=1 test",
    "test:unit": "pnpm test:scripts && pnpm -r --workspace-concurrency=1 test --exclude '**/*.integration.test.ts'",
    "test:scripts": "vitest run",
    "e2e": "node scripts/e2e.ts",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "oxlint . --type-aware --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit",
    "verify": "pnpm format:check && pnpm lint && pnpm knip && pnpm typecheck && pnpm test",
    "app:dev": "pnpm --filter @slipstream/app dev:client",
    "app:tv": "pnpm --filter @slipstream/app tv",
    "docker:build": "docker build --tag slipstream:dev ."
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.5",
    "@slipstream/api": "workspace:*",
    "@slipstream/domain": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "eslint-plugin-slop": "0.1.3",
    "knip": "6.46.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0"
  },
  "packageManager": "pnpm@12.21.0"
}

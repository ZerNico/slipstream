    "@slipstream/api": "workspace:*",
    "@slipstream/design-tokens": "workspace:*",
    "@slipstream/domain": "workspace:*",
    "@slipstream/i18n": "workspace:*",
    "@tanstack/react-query": "5.108.0",
    "effect": "catalog:",
